# Copy this file to .env on the VM and edit the values before starting Compose.

# Enable bundled Postgres/Redis by profile. For existing managed Postgres/Redis,
# remove local-postgres and/or local-redis and point DATABASE_URL/REDIS_URL at the managed service.
COMPOSE_PROFILES=local-postgres,local-redis,certbot-renew

APP_URL=https://pepetex.example.com
NGINX_SERVER_NAME=pepetex.example.com
NGINX_CLIENT_MAX_BODY_SIZE=50m
NGINX_CERT_RELOAD_INTERVAL_SECONDS=300
LETSENCRYPT_EMAIL=admin@example.com

# Bundled Postgres settings. Keep DATABASE_URL in sync with these values when using local-postgres.
POSTGRES_DB=pepetex
POSTGRES_USER=pepetex
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_HOST_PORT=5435
DATABASE_URL=postgresql://pepetex:replace-with-strong-database-password@postgres:5432/pepetex

# Bundled Redis settings. Replace REDIS_URL with your managed Redis URL when not using local-redis.
REDIS_HOST_PORT=6379
REDIS_URL=redis://redis:6379

GCS_BUCKET=pepetex-prod-assets

# GCS authentication:
# - On Google Compute Engine, prefer the VM service account and leave these commented.
# - For service-account JSON or gcloud ADC, set these and run Compose with docker-compose.gcp-auth.yml.
# GOOGLE_APPLICATION_CREDENTIALS_HOST=/opt/pepetex-secrets/gcp-credentials.json
# GOOGLE_APPLICATION_CREDENTIALS_CONTAINER=/var/secrets/google/application_default_credentials.json

MAX_UPLOAD_FILE_BYTES=31457280
REFERENCE_FILE_RETENTION_DAYS=30
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_NAME=PepeteX Admin
# Scrypt hashes contain dollar signs. Keep this value single-quoted in .env.
FIRST_ADMIN_PASSWORD_HASH='replace-with-real-password-hash'
DISABLE_EXTERNAL_TELEMETRY=true

HTTP_PORT=80
HTTPS_PORT=443

PEPETEX_WEB_IMAGE=pepetex-web:latest
PEPETEX_WORKER_IMAGE=pepetex-worker:latest
PEPETEX_NGINX_IMAGE=pepetex-nginx:latest
PEPETEX_MIGRATE_IMAGE=pepetex-migrate:latest
